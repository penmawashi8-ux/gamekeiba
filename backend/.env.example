# フロントエンドのオリジン（Vercel URL等に変更）
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# 所持金の保存先（Postgres）。未設定ならローカルの users.db (SQLite) を使う。
# Render の無課金プランはディスクが一時領域で、再デプロイや自動スリープからの
# 復帰で users.db が消えるため、本番では必ず設定すること（Neon の無料枠など）。
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 自動終了（0 = 無効）
# MAX_RUNTIME_HOURS=12
# IDLE_SHUTDOWN_MINUTES=30

# JST夜間停止（デフォルト: 1時〜8時。0にすると無効）
# NIGHT_START_JST=1
# NIGHT_END_JST=8
