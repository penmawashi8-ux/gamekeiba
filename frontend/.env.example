# バックエンドの WebSocket URL。
#
# 2通りある。両方あれば WS_URL が優先される。
#
#   WS_URL             … 実行時に /api/config 経由で読まれる（推奨）
#                        値を変えたらサーバーが再起動した時点で反映され、
#                        再デプロイ（再ビルド）は不要。
#   NEXT_PUBLIC_WS_URL … ビルド時にバンドルへ焼き込まれるフォールバック。
#                        値を変えても再ビルドするまで反映されない。
#
# バックエンドは Render（render.yaml / gamekeiba-backend）で動いている。
# Railway から移設済みなので railway.app のURLを入れないこと。
WS_URL=wss://gamekeiba-backend.onrender.com/ws
NEXT_PUBLIC_WS_URL=wss://gamekeiba-backend.onrender.com/ws

# ローカル開発時
# WS_URL=ws://127.0.0.1:8000/ws
